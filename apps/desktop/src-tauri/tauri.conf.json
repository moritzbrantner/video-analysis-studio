{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Analysis Studio",
  "version": "0.1.0",
  "identifier": "com.moritzbrantner.video-analysis-studio",
  "build": {
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --cwd ../ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Analysis Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
