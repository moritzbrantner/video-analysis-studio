{
  "name": "video-analysis-studio",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check:architecture": "python3 scripts/check_dependency_boundaries.py",
    "dev": "bun ./scripts/dev.mjs",
    "api:dev": "cargo run -p studio-api -- --data-dir ./studio-data",
    "ui:dev": "bun run --cwd apps/ui dev",
    "ui:build": "bun run --cwd apps/ui build",
    "ui:test": "bun run --cwd apps/ui test",
    "ui:test:e2e": "bun run --cwd apps/ui test:e2e",
    "ui:typecheck": "bun run --cwd apps/ui typecheck",
    "api:types": "cargo run -p studio-core --bin export_ts -- apps/ui/src/api/generated.ts",
    "api:types:check": "bun run api:types && git diff --exit-code apps/ui/src/api/generated.ts",
    "desktop:dev": "bun ./scripts/desktop-dev.mjs",
    "desktop:check": "cargo check -p studio-desktop"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1"
  }
}
