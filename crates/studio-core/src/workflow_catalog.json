{
  "version": 8,
  "nodes": [
    {
      "id": "react-page",
      "title": "React Page",
      "package_name": "@video-analysis-studio/ui",
      "category": "app",
      "ui_owned": true,
      "outputs": [
        { "id": "run", "label": "Run", "kind": "run_trigger" },
        {
          "id": "config",
          "label": "Config",
          "kind": "run_config",
          "exposable_input": true,
          "input_surface": "config",
          "runtime_validation": "external_input"
        }
      ]
    },
    {
      "id": "source",
      "title": "Source",
      "package_name": "@video-analysis-studio/ui",
      "category": "ingest",
      "ui_owned": true,
      "outputs": [
        {
          "id": "url",
          "label": "YouTube URL",
          "kind": "youtube_url",
          "exposable_input": true,
          "input_surface": "source_url",
          "runtime_validation": "external_input"
        },
        {
          "id": "collection",
          "label": "Collection URL",
          "kind": "youtube_collection_url",
          "exposable_input": true,
          "input_surface": "collection_url",
          "runtime_validation": "external_input"
        },
        {
          "id": "file",
          "label": "Video File",
          "kind": "video_file",
          "exposable_input": true,
          "input_surface": "file",
          "runtime_validation": "external_input"
        }
      ]
    },
    {
      "id": "image-source",
      "title": "Image Source",
      "package_name": "@video-analysis-studio/ui",
      "category": "ingest",
      "ui_owned": true,
      "outputs": [
        {
          "id": "image",
          "label": "Query Image",
          "kind": "image_file",
          "exposable_input": true,
          "input_surface": "file",
          "runtime_validation": "external_input"
        }
      ]
    },
    {
      "id": "image-catalog-source",
      "title": "Image Data Source",
      "package_name": "@video-analysis-studio/ui",
      "category": "data",
      "ui_owned": true,
      "outputs": [
        { "id": "images", "label": "Image Catalog", "kind": "object" }
      ]
    },
    {
      "id": "image-similarity",
      "title": "Image Similarity",
      "package_name": "@video-analysis-studio/ui",
      "category": "data",
      "ui_owned": true,
      "inputs": [
        { "id": "query", "label": "Query Image", "kind": "image_file" },
        { "id": "images", "label": "Image Catalog", "kind": "object" }
      ],
      "outputs": [
        { "id": "matches", "label": "Top 3 Matches", "kind": "json_report" }
      ]
    },
    {
      "id": "dashboard",
      "title": "Report Dashboard",
      "package_name": "@video-analysis-studio/ui",
      "category": "ui",
      "ui_owned": true,
      "inputs": [
        { "id": "report", "label": "Report", "kind": "json_report" }
      ],
      "outputs": [
        { "id": "view", "label": "Dashboard", "kind": "object" }
      ]
    },
    {
      "id": "vite-api",
      "title": "Studio API",
      "package_name": "studio-api",
      "category": "app",
      "inputs": [
        { "id": "run", "label": "Run", "kind": "run_trigger" },
        { "id": "config", "label": "Config", "kind": "run_config" }
      ],
      "outputs": [
        { "id": "args", "label": "Arguments", "kind": "run_config" }
      ]
    },
    {
      "id": "collection-manifest",
      "title": "Collection Manifest",
      "package_name": "yt-dlp",
      "category": "collection",
      "inputs": [
        { "id": "url", "label": "Collection URL", "kind": "youtube_collection_url" }
      ],
      "outputs": [
        { "id": "manifest", "label": "Manifest", "kind": "collection_manifest" },
        { "id": "items", "label": "Items", "kind": "collection_items" }
      ]
    },
    {
      "id": "download",
      "title": "YouTube Downloader",
      "package_name": "yt-dlp",
      "category": "ingest",
      "inputs": [
        { "id": "url", "label": "URL", "kind": "youtube_url" }
      ],
      "outputs": [
        { "id": "file", "label": "Video", "kind": "video_file" }
      ]
    },
    {
      "id": "ffmpeg",
      "title": "FFmpeg Ingest",
      "package_name": "video-analysis-ffmpeg",
      "category": "video",
      "inputs": [
        { "id": "file", "label": "Video", "kind": "video_file" }
      ],
      "outputs": [
        { "id": "metadata", "label": "Metadata", "kind": "object" },
        { "id": "frames", "label": "Frames", "kind": "object" },
        { "id": "audio", "label": "Audio", "kind": "object" },
        { "id": "wav", "label": "Wav", "kind": "media_file" }
      ]
    },
    {
      "id": "video-pipeline",
      "title": "Realtime Video Pipeline",
      "package_name": "video-analysis-core",
      "category": "video",
      "inputs": [
        { "id": "frames", "label": "Frames", "kind": "object" },
        { "id": "config", "label": "Config", "kind": "run_config" }
      ],
      "outputs": [
        { "id": "scenes", "label": "Scenes", "kind": "scene_list" },
        { "id": "observations", "label": "Observations", "kind": "observation_list" },
        { "id": "records", "label": "Records", "kind": "object" }
      ]
    },
    {
      "id": "content-detector",
      "title": "Content Detector",
      "package_name": "video-analysis-detectors",
      "category": "video",
      "inputs": [
        { "id": "frames", "label": "Frames", "kind": "object" },
        { "id": "config", "label": "Config", "kind": "run_config" }
      ],
      "outputs": [
        { "id": "scenes", "label": "Scenes", "kind": "scene_list" }
      ]
    },
    {
      "id": "model-sampler",
      "title": "Sampled Visual Models",
      "package_name": "video-analysis-models",
      "category": "video",
      "inputs": [
        { "id": "frames", "label": "Frames", "kind": "object" },
        { "id": "config", "label": "Config", "kind": "run_config" }
      ],
      "outputs": [
        { "id": "requests", "label": "Requests", "kind": "object" }
      ]
    },
    {
      "id": "external-models",
      "title": "External Commands",
      "package_name": "object / ocr / text command",
      "category": "video",
      "inputs": [
        { "id": "requests", "label": "Requests", "kind": "object" }
      ],
      "outputs": [
        { "id": "predictions", "label": "Predictions", "kind": "object" }
      ]
    },
    {
      "id": "observations",
      "title": "Observation Normalizer",
      "package_name": "video-analysis-core",
      "category": "video",
      "inputs": [
        { "id": "predictions", "label": "Predictions", "kind": "object" },
        { "id": "scenes", "label": "Scenes", "kind": "scene_list" }
      ],
      "outputs": [
        { "id": "observations", "label": "Observations", "kind": "observation_list" }
      ]
    },
    {
      "id": "transcriber",
      "title": "Transcriber",
      "package_name": "text-analysis-transcription",
      "category": "text",
      "inputs": [
        { "id": "wav", "label": "Wav", "kind": "media_file" }
      ],
      "outputs": [
        { "id": "segments", "label": "Segments", "kind": "transcript" }
      ]
    },
    {
      "id": "text-model-loader",
      "title": "Text Model Loader",
      "package_name": "text-generation-models",
      "category": "text",
      "inputs": [
        { "id": "model", "label": "Model Name", "kind": "string", "optional": true },
        { "id": "config", "label": "Provider Config", "kind": "run_config", "optional": true }
      ],
      "outputs": [
        { "id": "model", "label": "Text Model", "kind": "model_ref" }
      ]
    },
    {
      "id": "text-prompt-builder",
      "title": "Text Prompt Builder",
      "package_name": "text-generation-prompts",
      "category": "text",
      "inputs": [
        { "id": "instructions", "label": "Instructions", "kind": "template_string" },
        { "id": "text", "label": "Source Text", "kind": "string", "optional": true },
        { "id": "context", "label": "Context", "kind": "object", "optional": true }
      ],
      "outputs": [
        { "id": "prompt", "label": "Prompt", "kind": "string" },
        { "id": "template", "label": "Prompt Template", "kind": "template_string" }
      ]
    },
    {
      "id": "text-completion",
      "title": "Text Completion",
      "package_name": "text-generation-runtime",
      "category": "text",
      "inputs": [
        { "id": "prompt", "label": "Prompt", "kind": "string" },
        { "id": "model", "label": "Model", "kind": "model_ref", "optional": true },
        { "id": "parameters", "label": "Parameters", "kind": "run_config", "optional": true }
      ],
      "outputs": [
        { "id": "text", "label": "Generated Text", "kind": "string" },
        { "id": "response", "label": "Raw Response", "kind": "object" }
      ]
    },
    {
      "id": "text-json-writer",
      "title": "Text JSON Writer",
      "package_name": "text-generation-output",
      "category": "text",
      "inputs": [
        { "id": "text", "label": "Generated Text", "kind": "string" },
        { "id": "response", "label": "Response", "kind": "object", "optional": true },
        { "id": "schema", "label": "Schema", "kind": "object", "optional": true }
      ],
      "outputs": [
        { "id": "report", "label": "Text Report", "kind": "json_report" },
        { "id": "data", "label": "Structured Data", "kind": "object" }
      ]
    },
    {
      "id": "audio-model-loader",
      "title": "Audio Model Loader",
      "package_name": "audio-generation-models",
      "category": "audio",
      "inputs": [
        { "id": "checkpoint", "label": "Checkpoint", "kind": "string", "optional": true }
      ],
      "outputs": [
        { "id": "model", "label": "Model", "kind": "model_ref" },
        { "id": "vae", "label": "VAE", "kind": "vae_ref" }
      ]
    },
    {
      "id": "audio-prompt-encoder",
      "title": "Audio Prompt Encoder",
      "package_name": "audio-generation-conditioning",
      "category": "audio",
      "inputs": [
        { "id": "model", "label": "Model", "kind": "model_ref" },
        { "id": "prompt", "label": "Prompt", "kind": "string" },
        { "id": "negative", "label": "Negative Prompt", "kind": "string", "optional": true }
      ],
      "outputs": [
        { "id": "positive", "label": "Positive", "kind": "conditioning" },
        { "id": "negative", "label": "Negative", "kind": "conditioning" }
      ]
    },
    {
      "id": "audio-latent-sampler",
      "title": "Audio Latent Sampler",
      "package_name": "audio-generation-sampler",
      "category": "audio",
      "inputs": [
        { "id": "model", "label": "Model", "kind": "model_ref" },
        { "id": "positive", "label": "Positive", "kind": "conditioning" },
        { "id": "negative", "label": "Negative", "kind": "conditioning", "optional": true },
        { "id": "seed", "label": "Seed", "kind": "number", "optional": true },
        { "id": "seconds", "label": "Seconds", "kind": "number", "optional": true },
        { "id": "steps", "label": "Steps", "kind": "number", "optional": true },
        { "id": "cfg", "label": "CFG", "kind": "number", "optional": true }
      ],
      "outputs": [
        { "id": "samples", "label": "Latent Audio", "kind": "latent_batch" }
      ]
    },
    {
      "id": "audio-vae-decode",
      "title": "Audio VAE Decode",
      "package_name": "audio-generation-codecs",
      "category": "audio",
      "inputs": [
        { "id": "samples", "label": "Latent Audio", "kind": "latent_batch" },
        { "id": "vae", "label": "VAE", "kind": "vae_ref" }
      ],
      "outputs": [
        { "id": "waveform", "label": "Waveform", "kind": "audio_waveform" }
      ]
    },
    {
      "id": "audio-export",
      "title": "Audio Export",
      "package_name": "audio-generation-output",
      "category": "output",
      "inputs": [
        { "id": "waveform", "label": "Waveform", "kind": "audio_waveform" },
        { "id": "filename", "label": "Filename Template", "kind": "template_string", "optional": true }
      ],
      "outputs": [
        { "id": "audio", "label": "Audio File", "kind": "audio_file" },
        { "id": "media", "label": "Media File", "kind": "media_file" }
      ]
    }
  ]
}
